# ===== 基础设施（docker compose 默认值） =====
# 容器映射到 15432，避免与本机已有 PostgreSQL 冲突
DATABASE_URL=postgres://chappie:chappie@127.0.0.1:15432/chappie
REDIS_URL=redis://127.0.0.1:6379

# ===== Rust ↔ Bun 内部共享密钥（部署时务必修改） =====
INTERNAL_TOKEN=dev-internal-token-change-me

# ===== 端口 =====
# 注意：macOS 的 AirPlay Receiver 默认占用 7000，故网关使用 7100
GATEWAY_PORT=7100        # im-core 对外 HTTP/WS
INTERNAL_PORT=7001       # im-core 内部 API（仅 127.0.0.1）
ADMIN_PORT=7002          # ai-platform 控制台 API

# ===== 模型网关 =====
# provider: mock | openai-chat | openai-responses | anthropic
# 未配置 API key 或 provider=mock 时，自动降级为内置 Mock（规则模板），开箱即跑。
MODEL_PROVIDER=mock
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4o-mini
# 扩展思考开关（provider 支持时生效；思考内容仅主人可见，前端可展开）
MODEL_THINKING=true
# 思考 token 预算（需小于模型最大输出；Anthropic 官方要求 max_tokens > budget_tokens）
MODEL_THINKING_BUDGET_TOKENS=1024

# 上下文接话决策小模型（可选；留空则只用规则）
# CLASSIFIER_BASE_URL 指向 classifier/ 的 mmBERT ONNX 服务，例如 http://127.0.0.1:7010
# 只对未 @ 的 auto/direct 候选调用；超时/失败自动回退规则并熔断
CLASSIFIER_PROVIDER=
CLASSIFIER_BASE_URL=
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL=
CLASSIFIER_TIMEOUT_MS=12000
# pairwise 候选分数超过沉默候选的最小 margin（校准后填写）
CLASSIFIER_RANK_MIN_MARGIN=0

# ===== 工作群角色匹配 =====
# 规则兜底：有职位/部门元数据时，按职责关键词/点名筛选 auto/direct 候选
AI_ROLE_MATCH=true
# linear=本地线性 pairwise 模型优先；mmbert=远端/本地 ONNX /rank 服务；rule=仅规则；off=不启用模型
AI_ROLE_MODEL=linear
# 线性模型路径；默认 ai/src/models/linear-pairwise.json
# AI_ROLE_MODEL_PATH=

# ===== 登录（邮箱 + 验证码） =====
# dev 模式：验证码在接口响应与日志中直接返回，方便本地体验
AUTH_CODE_DEV_ECHO=true
# 邮件验证码（Resend）：配置后真实发送；留空时验证码仅打印日志（仅开发）
RESEND_API_KEY=
# 发件人：域名需在 Resend 完成验证；未验证时可用 onboarding@resend.dev（仅能发给账户本人）
MAIL_FROM=Chappie <no-reply@chappie.run>
AUTH_CODE_TTL_SECONDS=300

# ===== 推送通知（Expo Push → APNs/FCM） =====
# 未配置时推送静默降级（消息/卡片仍经 WebSocket 实时投递）
EXPO_ACCESS_TOKEN=
# 自建/代理可覆盖 push 服务地址
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ===== 日志 =====
RUST_LOG=im_core=debug,tower_http=info,info

# ===== AI 平台 =====
# 每个分身的日预算（美元），超出自动降级为手动档
AVATAR_DAILY_BUDGET_USD=1.0
# 分身对 AI 对话的最大跳数（防 AI 互聊死循环）
MAX_HOP_COUNT=3

# ===== 任务断连恢复（租约 + 检查点） =====
# 任务租约 TTL（秒）：心跳每 taskHeartbeatMs 续约，过期即视为 worker 崩溃、由 scheduler 认领续跑
AI_TASK_LEASE_TTL_S=120
AI_TASK_HEARTBEAT_MS=30000
# 恢复时效线（秒）：超过即视为过期任务直接丢弃（设计方案 §26.3）
AI_RECOVERY_STALE_S=3600
# 存量僵尸行认领宽限（秒）：lease 为 NULL 且超过该时长的 created/planning 任务会被恢复
AI_RECOVERY_CREATED_GRACE_S=600
# 已决议审批续跑中断的认领宽限（秒）：避免与刚批准的正常续跑竞争
AI_RECOVERY_APPROVAL_GRACE_S=120
# 恢复清扫每 tick 认领上限
AI_RECOVERY_BATCH=5

# ===== 端云一体 =====
# 多节点部署时所有 im-core 实例必须使用同一个 epoch；留空则每个进程随机生成。
# 客户端据此判断服务端是否重启；节点间不一致会导致误重置本地投影。
SERVER_EPOCH=

# ===== 上下文与主动性 =====
# 提示词历史区字符预算（有界上下文；超限时优先保留最新消息）
AI_CONTEXT_CHAR_BUDGET=6000
# 合理沉默阈值：群聊 auto 档未被 @ 且置信度低于该值时不回复；0 = 关闭
AI_SILENCE_MIN_CONFIDENCE=0.6

# ===== 长程任务（分段执行 + 定时续驱） =====
# 单段 ReAct 循环最多工具轮次（3→10 后多步任务可在一次运行内完成更多步骤）
AI_MAX_TOOL_ROUNDS=10
# 单段执行时间预算（秒）：超时且未完成 → 挂起 waiting_continuation，由 scheduler 续驱
AI_TASK_SEGMENT_MAX_S=240
# 续驱延迟（秒）与每 tick 认领上限
AI_CONTINUATION_DELAY_S=5
AI_CONTINUATION_BATCH=3
# 长程任务整体护栏：超时转交主人；最大段数防空转
AI_LONG_TASK_MAX_S=1800
AI_LONG_TASK_MAX_SEGMENTS=8

# ===== 本地/外部工具（新增能力） =====
# 应用内演示账本初始余额（非真实资金）
WALLET_INITIAL_BALANCE=10000
# 网页搜索：tavily | brave | bing | duckduckgo（默认 Bing，无需 key；DDG 在部分网络不可达）
WEB_SEARCH_PROVIDER=bing
TAVILY_API_KEY=
BRAVE_API_KEY=
# 入站邮件 webhook 共享密钥（Resend/SendGrid/Mailgun 等 POST JSON）
INBOUND_EMAIL_TOKEN=
# 文件存储：配置 S3 则走 S3，否则落本地目录
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
FILE_LOCAL_DIR=.data/files
FILE_MAX_BYTES=20971520
# 附件签名 URL 的 HMAC 密钥；留空复用 INTERNAL_TOKEN
FILE_URL_SECRET=
# 当前模型支持图片输入时设为 true（DeepSeek Flash、gpt-4o、claude 等已验证视觉模型）
MODEL_MULTIMODAL=true
MODEL_MULTIMODAL_MAX_IMAGES=3
MODEL_MULTIMODAL_MAX_IMAGE_BYTES=4194304
MODEL_MULTIMODAL_MAX_TOTAL_BYTES=8388608
# 附件突发合并窗口（毫秒）：图片/文件后紧跟同一发送者的文本时，只由最后一条触发一次回复
AI_ATTACHMENT_BURST_MS=1200
# 自动读取最近文本/PDF 附件并注入提示词（模型无需自行调用 file.read）
AI_FILE_AUTO_READ=true
AI_FILE_AUTO_READ_MAX_FILES=2
AI_FILE_AUTO_READ_MAX_CHARS=6000
AI_FILE_AUTO_READ_MAX_BYTES=8388608
# 只自动读取最近 N 分钟内的附件；更早的文件仍可通过 file.read 按需读取
AI_FILE_AUTO_READ_WINDOW_MINUTES=10

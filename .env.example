# ===== 基础设施（docker compose 默认值） =====
# 容器映射到 15432，避免与本机已有 PostgreSQL 冲突
DATABASE_URL=postgres://chappie:chappie@127.0.0.1:15432/chappie
REDIS_URL=redis://127.0.0.1:6379

# ===== Rust ↔ Bun 内部共享密钥（部署时务必修改） =====
INTERNAL_TOKEN=dev-internal-token-change-me

# ===== 端口 =====
# 注意：macOS 的 AirPlay Receiver 默认占用 7000，故网关使用 7100
GATEWAY_PORT=7100        # im-core 对外 HTTP/WS
INTERNAL_PORT=7001       # im-core 内部 API（仅 127.0.0.1）
ADMIN_PORT=7002          # ai-platform 控制台 API

# ===== 模型网关 =====
# provider: mock | openai-chat | openai-responses | anthropic
# 未配置 API key 或 provider=mock 时，自动降级为内置 Mock（规则模板），开箱即跑。
MODEL_PROVIDER=mock
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4o-mini

# 分类小模型（可选；留空则使用规则分类器 + 主模型兜底）
CLASSIFIER_PROVIDER=
CLASSIFIER_BASE_URL=
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL=

# ===== 登录（邮箱 + 验证码） =====
# dev 模式：验证码在接口响应与日志中直接返回，方便本地体验
AUTH_CODE_DEV_ECHO=true
# SMTP（可选，如 smtps://user:pass@smtp.example.com:465）；留空时验证码仅打印日志
SMTP_URL=
AUTH_CODE_TTL_SECONDS=300

# ===== 日志 =====
RUST_LOG=im_core=debug,tower_http=info,info

# ===== AI 平台 =====
# 每个分身的日预算（美元），超出自动降级为手动档
AVATAR_DAILY_BUDGET_USD=1.0
# 分身对 AI 对话的最大跳数（防 AI 互聊死循环）
MAX_HOP_COUNT=3

# ===== 任务断连恢复（租约 + 检查点） =====
# 任务租约 TTL（秒）：心跳每 taskHeartbeatMs 续约，过期即视为 worker 崩溃、由 scheduler 认领续跑
AI_TASK_LEASE_TTL_S=120
AI_TASK_HEARTBEAT_MS=30000
# 恢复时效线（秒）：超过即视为过期任务直接丢弃（设计方案 §26.3）
AI_RECOVERY_STALE_S=3600
# 存量僵尸行认领宽限（秒）：lease 为 NULL 且超过该时长的 created/planning 任务会被恢复
AI_RECOVERY_CREATED_GRACE_S=600
# 已决议审批续跑中断的认领宽限（秒）：避免与刚批准的正常续跑竞争
AI_RECOVERY_APPROVAL_GRACE_S=120
# 恢复清扫每 tick 认领上限
AI_RECOVERY_BATCH=5
